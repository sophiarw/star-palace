{
  "name": "star-palace",
  "version": "0.1.0",
  "description": "Persistent embedding-based 2D star map of your files",
  "scripts": {
    "dev:web": "vite --config vite.web.config.ts",
    "dev:daemon": "tsx src/daemon/index.ts",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "VITEST_INCLUDE_CONTRACT=1 vitest run tests/api/contract.test.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "index": "tsx scripts/index-cli.ts",
    "seed:demo": "bash scripts/fetch-corpus.sh && tsx scripts/seed-mvp.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "hnswlib-node": "^3.0.0",
    "ml-pca": "^4.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
